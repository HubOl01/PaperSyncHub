<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
            <Button Classes="icons" Content="Hello World"></Button>
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource SecondBackground}"></Setter>
        <Setter Property="Foreground" Value="#F0F0F0"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="Padding" Value="16, 10"></Setter>
        <Setter Property="CornerRadius" Value="10"></Setter>
        
    </Style>
    <Style Selector="Button.icons /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource SecondBackground}"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="RenderTransform" Value="scale(1)"></Setter>
        
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:.3"></BrushTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" ></TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icons">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    
    <Style Selector="Button.transparent /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource SecondBackground}"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="RenderTransform" Value="scale(1)"></Setter>
        
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:.3"></BrushTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" ></TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondHoverBackground}"></Setter>
        <Setter Property="Foreground" Value="WhiteSmoke"></Setter>
    </Style>
    <Style Selector="Button.transparent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource SecondHoverBackground}"></Setter>
        <Setter Property="RenderTransform" Value="scale(1.05)"></Setter>
    </Style>
    <Style Selector="Button.icons:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource SecondHoverBackground}"></Setter>
        <Setter Property="RenderTransform" Value="scale(1.05)"></Setter>
    </Style>
    
  
    
</Styles>
