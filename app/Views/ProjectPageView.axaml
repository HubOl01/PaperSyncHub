<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:app="using:app"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:app.ViewModels"
             xmlns:views="clr-namespace:app.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="app.Views.ProjectPageView"
             x:DataType="vm:ProjectPageViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Топбар -->
        <Border Background="White" MinWidth="20" BoxShadow="0 4 12 0 #1A000000" Margin="0 0 0 10">
            
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Classes="transparent" Command="{Binding GoHomeCommand}">
                <Svg Path="/Assets/logo_org.svg" Height="30" Margin="10 0 0 0 "/>
            </Button>
            <Panel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
    
                <!-- Режим просмотра: клик активирует редактирование -->
                <Button Classes="transparent"
                        Command="{Binding RenameProjectCommand}"
                        IsVisible="{Binding !IsRenamingProject}">
                    <TextBlock Text="{Binding ProjectName}" FontWeight="Medium" FontSize="18"/>
                </Button>

                <!-- Режим редактирования -->
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsRenamingProject}">
                    <TextBox Text="{Binding NewProjectName}"
                             FontSize="16"
                             MinWidth="200"
                             BorderThickness="0,0,0,2"
                             BorderBrush="#4F46E5"
                             Background="Transparent"/>
                    <Button Classes="icons" Command="{Binding ConfirmRenameCommand}"
                            ToolTip.Tip="Сохранить">
                        <Svg Path="/Assets/save.svg" Height="20" Width="20"/>
                    </Button>
                    <Button Classes="icons" Command="{Binding CancelRenameCommand}"
                            ToolTip.Tip="Отмена">
                        <Svg Path="/Assets/close.svg" Height="20" Width="20"/>
                    </Button>
                </StackPanel>
            </Panel>
            <!-- Иконки справа -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="12">
                <Button Classes="icons" Command="{Binding ShowTemplatesCommand}">
                    <Svg Path="/Assets/templates.svg" Height="30" Width="30"/>
                </Button>
                <Button Classes="icons" Command="{Binding ShowTasksCommand}">
                    <Svg Path="/Assets/task.svg" Height="30" Width="30"/>
                </Button>
                <Button Classes="icons" Command="{Binding GoBackCommand}">
                    <Svg Path="/Assets/exit.svg" Height="30" Width="30"/>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <!-- Левая панель артефактов -->
            <Border Background="White" MinHeight="200" MinWidth="200" CornerRadius=" 0 10 10 0" BoxShadow="0 4 12 0 #1A000000"  Margin="0 0 10 10">
                <Grid RowDefinitions="Auto,*" Margin="10">
                    <Border Grid.Row="0" Height="50" BorderThickness="0 0 0 1.3" BorderBrush="Black">
                        <DockPanel LastChildFill="True"
                                   VerticalAlignment="Center">
        
                            <Button DockPanel.Dock="Right" 
                                    Classes="icons"
                                    Command="{Binding AddArtifactFromFileCommand}"
                                    VerticalAlignment="Center">
                                <Svg Path="/Assets/add_doc.svg" Height="25" Width="25"/>
                            </Button>
        
                            <TextBlock Text="Структура проекта:" 
                                       FontWeight="Medium" 
                                       FontSize="16" 
                                       Margin="0,0,0,8"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>
                        </DockPanel>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Artifacts}"
                             SelectedItem="{Binding SelectedArtifact}"
                             SelectionChanged="ListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Padding="8,6"
                                           Cursor="Hand">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Удалить"
                                                      Command="{Binding $parent[ListBox].((vm:ProjectPageViewModel)DataContext).DeleteArtifactCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
           
            <!-- Правая панель — редактор или планировщик, переключаются между собой -->
            <ContentControl Grid.Column="1" Content="{Binding CenterContent}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:TaskPageViewModel}">
                        <views:TaskPageView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TextEditorViewModel}">
                        <views:TextEditorView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>
        
        <Border Grid.Row="2" Background="White" MinWidth="20" BoxShadow="0 4 12 4 #1A000000" Margin="0 10 0 0">
        <StackPanel  Orientation="Horizontal" Spacing="8" Margin="8">
            <!-- <Button Content="← Назад" Command="{Binding GoBackCommand}"/> -->
            <Button Classes="icons" Command="{Binding ShowGitPanelCommand}"
                    ToolTip.Tip="Синхронизировать изменения">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Svg Path="/Assets/git_sync.svg" Height="20" Width="20"/>
                    <TextBlock Text="Синхронизировать изменения"
                               FontWeight="Bold" Foreground="Black"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
            </Border>
        
    </Grid>
</UserControl>
