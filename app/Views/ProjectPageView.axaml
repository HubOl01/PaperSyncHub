<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:app.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="app.Views.ProjectPageView"
             x:DataType="vm:ProjectPageViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Топбар -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Classes="transparent" Command="{Binding SaveProjectCommand}">
                <Svg Path="/Assets/logo_org.svg" Height="30"/>
            </Button>
            <!-- Клик по названию — через Interaction Trigger или кнопку-призрак -->
            <!-- Вместо Button с TextBlock -->
            <Panel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
    
                <!-- Режим просмотра: клик активирует редактирование -->
                <Button Classes="transparent"
                        Command="{Binding RenameProjectCommand}"
                        IsVisible="{Binding !IsRenamingProject}">
                    <TextBlock Text="{Binding ProjectName}" FontSize="16"/>
                </Button>

                <!-- Режим редактирования -->
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsRenamingProject}">
                    <TextBox Text="{Binding NewProjectName}"
                             FontSize="16"
                             MinWidth="200"
                             BorderThickness="0,0,0,2"
                             BorderBrush="#4F46E5"
                             Background="Transparent"/>
                    <Button Classes="icons" Command="{Binding ConfirmRenameCommand}"
                            ToolTip.Tip="Сохранить">
                        <Svg Path="/Assets/save.svg" Height="20" Width="20"/>
                    </Button>
                    <Button Classes="icons" Command="{Binding CancelRenameCommand}"
                            ToolTip.Tip="Отмена">
                        <Svg Path="/Assets/close.svg" Height="20" Width="20"/>
                    </Button>
                </StackPanel>
            </Panel>
            <!-- Иконки справа -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="12">
                <Button Classes="icons" Command="{Binding SaveProjectCommand}">
                    <Svg Path="/Assets/templates.svg" Height="30" Width="30"/>
                </Button>
                <Button Classes="icons" Command="{Binding ShowCommitsCommand}">
                    <Svg Path="/Assets/task.svg" Height="30" Width="30"/>
                </Button>
                <!-- <Button Classes="icons" Command="{Binding SaveProjectCommand}"> -->
                <!--     <Svg Path="/Assets/save.svg" Height="20" Width="20"/> -->
                <!-- </Button> -->
                <Button Classes="icons" Command="{Binding ShowCommitsCommand}">
                    <Svg Path="/Assets/exit.svg" Height="30" Width="30"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <!-- Левая панель артефактов -->
            <StackPanel Grid.Column="0" Margin="8">
                <TextBlock Text="Структура проекта:" FontWeight="Bold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Artifacts}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <!-- Правая панель — редактор (пока пусто) -->
            <ContentControl Grid.Column="1" Content="{Binding SelectedArtifact}"/>
        </Grid>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="← Назад" Command="{Binding GoBackCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
